<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/screen_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:orientation="vertical">

    <include layout="@layout/layout_app_bar" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="@dimen/space_xl">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/screen_margin_h"
            android:paddingTop="@dimen/space_sm">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/insights_prev"
                    android:layout_width="@dimen/min_touch"
                    android:layout_height="@dimen/min_touch"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/previous_period"
                    android:src="@drawable/ic_chevron_left"
                    app:tint="?attr/colorOnSurface" />

                <TextView
                    android:id="@+id/insights_month"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:accessibilityHeading="true"
                    android:gravity="center"
                    android:textAppearance="@style/TextAppearance.DET.SectionTitle" />

                <ImageButton
                    android:id="@+id/insights_next"
                    android:layout_width="@dimen/min_touch"
                    android:layout_height="@dimen/min_touch"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/next_period"
                    android:src="@drawable/ic_chevron_right"
                    app:tint="?attr/colorOnSurface" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/insights_note"
                android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                android:textColor="?attr/colorOnSurfaceVariant" />

            <TextView
                android:id="@+id/insights_error"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_lg"
                android:gravity="center"
                android:text="@string/load_failed"
                android:textAppearance="@style/TextAppearance.DET.Body"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/insights_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Summary -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_md">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/space_lg">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:baselineAligned="false"
                            android:orientation="horizontal">

                            <LinearLayout
                                android:id="@+id/insights_income_block"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:focusable="true"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:importantForAccessibility="no"
                                    android:text="@string/insights_income"
                                    android:textAppearance="@style/TextAppearance.DET.Label" />

                                <TextView
                                    android:id="@+id/insights_income"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:importantForAccessibility="no"
                                    android:textAppearance="@style/TextAppearance.DET.AmountSmall"
                                    android:textColor="@color/income" />
                            </LinearLayout>

                            <LinearLayout
                                android:id="@+id/insights_expense_block"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:focusable="true"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:importantForAccessibility="no"
                                    android:text="@string/insights_expenses"
                                    android:textAppearance="@style/TextAppearance.DET.Label" />

                                <TextView
                                    android:id="@+id/insights_expense"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:importantForAccessibility="no"
                                    android:textAppearance="@style/TextAppearance.DET.AmountSmall"
                                    android:textColor="@color/expense" />
                            </LinearLayout>
                        </LinearLayout>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_md"
                            android:text="@string/insights_vs_last_month"
                            android:textAppearance="@style/TextAppearance.DET.Label" />

                        <TextView
                            android:id="@+id/insights_vs"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                            android:textColor="?attr/colorOnSurface" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_md"
                            android:text="@string/insights_average"
                            android:textAppearance="@style/TextAppearance.DET.Label" />

                        <TextView
                            android:id="@+id/insights_average"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                            android:textColor="?attr/colorOnSurface" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_md"
                            android:text="@string/insights_savings_rate"
                            android:textAppearance="@style/TextAppearance.DET.Label" />

                        <TextView
                            android:id="@+id/insights_savings"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                            android:textColor="?attr/colorOnSurface" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Daily chart -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_md">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/space_lg">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:accessibilityHeading="true"
                            android:text="@string/insights_daily_chart"
                            android:textAppearance="@style/TextAppearance.DET.SectionTitle" />

                        <com.litemobiletools.dailyexpensetracker.ui.widget.BarChartView
                            android:id="@+id/insights_chart"
                            android:layout_width="match_parent"
                            android:layout_height="150dp"
                            android:layout_marginTop="@dimen/space_md" />

                        <TextView
                            android:id="@+id/insights_chart_empty"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:text="@string/insights_daily_chart_empty"
                            android:textAppearance="@style/TextAppearance.DET.Body"
                            android:visibility="gone" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Top categories -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/insights_categories_card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_md">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingTop="@dimen/space_lg">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:accessibilityHeading="true"
                            android:paddingHorizontal="@dimen/space_lg"
                            android:text="@string/insights_top_categories"
                            android:textAppearance="@style/TextAppearance.DET.SectionTitle" />

                        <LinearLayout
                            android:id="@+id/insights_categories"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Largest expenses -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/insights_largest_card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_md">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/space_lg">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:accessibilityHeading="true"
                            android:text="@string/insights_largest"
                            android:textAppearance="@style/TextAppearance.DET.SectionTitle" />

                        <LinearLayout
                            android:id="@+id/insights_largest"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Highest days -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/insights_days_card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_md">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/space_lg">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:accessibilityHeading="true"
                            android:text="@string/insights_highest_days"
                            android:textAppearance="@style/TextAppearance.DET.SectionTitle" />

                        <LinearLayout
                            android:id="@+id/insights_days"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Budget observations -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_md">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingTop="@dimen/space_lg">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:accessibilityHeading="true"
                            android:paddingHorizontal="@dimen/space_lg"
                            android:text="@string/insights_budgets"
                            android:textAppearance="@style/TextAppearance.DET.SectionTitle" />

                        <TextView
                            android:id="@+id/insights_budget_text"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:paddingHorizontal="@dimen/space_lg"
                            android:paddingVertical="@dimen/space_sm"
                            android:textAppearance="@style/TextAppearance.DET.Body" />

                        <LinearLayout
                            android:id="@+id/insights_budgets"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>

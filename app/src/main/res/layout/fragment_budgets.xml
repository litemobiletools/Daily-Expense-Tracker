<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="96dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/screen_margin_h"
            android:paddingTop="@dimen/space_sm">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/budgets_goals"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/space_xs"
                    android:layout_weight="1"
                    android:insetLeft="0dp"
                    android:insetRight="0dp"
                    android:minHeight="@dimen/min_touch"
                    android:paddingHorizontal="@dimen/space_sm"
                    android:text="@string/budgets_goals"
                    app:icon="@drawable/ic_flag" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/budgets_recurring"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/space_xs"
                    android:layout_weight="1"
                    android:insetLeft="0dp"
                    android:insetRight="0dp"
                    android:minHeight="@dimen/min_touch"
                    android:paddingHorizontal="@dimen/space_sm"
                    android:text="@string/budgets_recurring"
                    app:icon="@drawable/ic_repeat" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/budgets_insights"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_xs"
                    android:layout_weight="1"
                    android:insetLeft="0dp"
                    android:insetRight="0dp"
                    android:minHeight="@dimen/min_touch"
                    android:paddingHorizontal="@dimen/space_sm"
                    android:text="@string/budgets_insights"
                    app:icon="@drawable/ic_reports" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/budgets_period_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                app:checkedButton="@+id/budgets_period_monthly"
                app:selectionRequired="true"
                app:singleSelection="true">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/budgets_period_monthly"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:minHeight="@dimen/min_touch"
                    android:text="@string/budgets_monthly" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/budgets_period_weekly"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:minHeight="@dimen/min_touch"
                    android:text="@string/budgets_weekly" />
            </com.google.android.material.button.MaterialButtonToggleGroup>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/budgets_prev"
                    android:layout_width="@dimen/min_touch"
                    android:layout_height="@dimen/min_touch"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/previous_period"
                    android:src="@drawable/ic_chevron_left"
                    app:tint="?attr/colorOnSurface" />

                <TextView
                    android:id="@+id/budgets_period_label"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:accessibilityHeading="true"
                    android:gravity="center"
                    android:textAppearance="@style/TextAppearance.DET.SectionTitle" />

                <ImageButton
                    android:id="@+id/budgets_next"
                    android:layout_width="@dimen/min_touch"
                    android:layout_height="@dimen/min_touch"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/next_period"
                    android:src="@drawable/ic_chevron_right"
                    app:tint="?attr/colorOnSurface" />
            </LinearLayout>

            <ProgressBar
                android:id="@+id/budgets_loading"
                style="?android:attr/progressBarStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/space_lg"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/budgets_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_md"
                    android:accessibilityHeading="true"
                    android:text="@string/budgets_overall"
                    android:textAppearance="@style/TextAppearance.DET.Label"
                    android:textColor="?attr/colorPrimary"
                    android:textStyle="bold" />

                <FrameLayout
                    android:id="@+id/budgets_overall_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_lg"
                    android:accessibilityHeading="true"
                    android:text="@string/budgets_by_category"
                    android:textAppearance="@style/TextAppearance.DET.Label"
                    android:textColor="?attr/colorPrimary"
                    android:textStyle="bold" />

                <LinearLayout
                    android:id="@+id/budgets_category_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <TextView
                    android:id="@+id/budgets_category_empty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_sm"
                    android:text="@string/budgets_category_empty"
                    android:textAppearance="@style/TextAppearance.DET.Body"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/budgets_note"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_lg"
                    android:text="@string/budgets_note"
                    android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                    android:textColor="?attr/colorOnSurfaceVariant" />
            </LinearLayout>

            <TextView
                android:id="@+id/budgets_error"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_lg"
                android:gravity="center"
                android:text="@string/load_failed"
                android:textAppearance="@style/TextAppearance.DET.Body"
                android:visibility="gone" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/budgets_add_fab"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="@dimen/space_lg"
        android:contentDescription="@string/budgets_add"
        android:text="@string/budgets_add"
        app:icon="@drawable/ic_add" />
</androidx.coordinatorlayout.widget.CoordinatorLayout>

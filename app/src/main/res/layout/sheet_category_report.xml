<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/space_xl"
        android:paddingBottom="@dimen/space_xl"
        android:paddingTop="@dimen/space_sm">

        <TextView
            android:id="@+id/category_report_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:accessibilityHeading="true"
            android:textAppearance="@style/TextAppearance.Material3.TitleLarge"
            android:textColor="?attr/colorOnSurface" />

        <TextView
            android:id="@+id/category_report_period"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.DET.Body" />

        <TextView
            android:id="@+id/category_report_total"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:textAppearance="@style/TextAppearance.DET.AmountSmall" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/category_report_sort"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            app:selectionRequired="true"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/category_report_sort_amount"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="@string/category_report_sort_amount" />

            <com.google.android.material.chip.Chip
                android:id="@+id/category_report_sort_date"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/category_report_sort_date" />
        </com.google.android.material.chip.ChipGroup>

        <LinearLayout
            android:id="@+id/category_report_rows"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/category_report_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingVertical="@dimen/space_sm"
            android:textAppearance="@style/TextAppearance.DET.Body"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/category_report_open"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            android:minHeight="@dimen/min_touch"
            android:text="@string/category_report_open"
            app:icon="@drawable/ic_transactions" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>

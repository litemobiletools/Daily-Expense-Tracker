<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/screen_margin_h"
            android:paddingTop="@dimen/space_sm">

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/search_layout"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="@string/search_hint"
                app:endIconMode="clear_text"
                app:startIconDrawable="@drawable/ic_search">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/search_input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:imeOptions="actionSearch"
                    android:inputType="text"
                    android:maxLength="60"
                    android:maxLines="1"
                    android:saveEnabled="false" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/filter_button"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="wrap_content"
                android:layout_height="56dp"
                android:layout_marginStart="@dimen/space_sm"
                android:text="@string/filters_button"
                app:icon="@drawable/ic_filter" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/screen_margin_h"
            android:paddingEnd="@dimen/space_sm">

            <TextView
                android:id="@+id/history_count"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minHeight="@dimen/min_touch"
                android:gravity="center_vertical"
                android:textAppearance="@style/TextAppearance.DET.Label" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/clear_filters"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/min_touch"
                android:text="@string/clear_filters"
                android:visibility="gone" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/history_list"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingHorizontal="@dimen/screen_margin_h"
                android:paddingBottom="96dp" />

            <com.google.android.material.progressindicator.CircularProgressIndicator
                android:id="@+id/history_loading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:contentDescription="@string/history_loading"
                android:indeterminate="true"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/history_empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingHorizontal="@dimen/screen_margin_h"
                android:visibility="gone">

                <ImageView
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:background="@drawable/bg_circle_tonal"
                    android:importantForAccessibility="no"
                    android:padding="18dp"
                    android:src="@drawable/ic_receipt"
                    app:tint="?attr/colorOnPrimaryContainer" />

                <TextView
                    android:id="@+id/history_empty_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_md"
                    android:accessibilityHeading="true"
                    android:textAppearance="@style/TextAppearance.DET.SectionTitle" />

                <TextView
                    android:id="@+id/history_empty_message"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xs"
                    android:gravity="center"
                    android:maxWidth="320dp"
                    android:textAppearance="@style/TextAppearance.DET.Body" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/history_empty_action"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_md"
                    android:minHeight="@dimen/min_touch"
                    android:text="@string/clear_search_and_filters"
                    android:visibility="gone" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/history_error"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingHorizontal="@dimen/screen_margin_h"
                android:visibility="gone">

                <ImageView
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:background="@drawable/bg_circle_solid"
                    android:backgroundTint="@color/expense_container"
                    android:importantForAccessibility="no"
                    android:padding="16dp"
                    android:src="@drawable/ic_error"
                    app:tint="@color/expense" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_md"
                    android:accessibilityHeading="true"
                    android:text="@string/history_error_title"
                    android:textAppearance="@style/TextAppearance.DET.SectionTitle" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xs"
                    android:gravity="center"
                    android:maxWidth="320dp"
                    android:text="@string/history_error_message"
                    android:textAppearance="@style/TextAppearance.DET.Body" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/history_retry"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_md"
                    android:minHeight="@dimen/min_touch"
                    android:text="@string/retry" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>

    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/transactions_add_fab"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="@dimen/space_lg"
        android:contentDescription="@string/add_transaction"
        android:text="@string/add_transaction"
        app:icon="@drawable/ic_add" />
</androidx.coordinatorlayout.widget.CoordinatorLayout>

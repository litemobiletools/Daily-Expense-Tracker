<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:focusable="true"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingVertical="@dimen/space_xl">

    <ImageView
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:background="@drawable/bg_circle_tonal"
        android:importantForAccessibility="no"
        android:padding="14dp"
        android:src="@drawable/ic_receipt"
        app:tint="?attr/colorOnPrimaryContainer" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_md"
        android:text="@string/home_empty_title"
        android:textAppearance="@style/TextAppearance.DET.SectionTitle" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_xs"
        android:gravity="center"
        android:maxWidth="320dp"
        android:text="@string/home_empty_message"
        android:textAppearance="@style/TextAppearance.DET.Body" />
</LinearLayout>

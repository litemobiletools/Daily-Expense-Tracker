<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- One theme for both modes: light/dark differences live in values/colors.xml and values-night/colors.xml. -->
    <style name="Base.Theme.DailyExpenseTrackerOffline" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/det_primary</item>
        <item name="colorOnPrimary">@color/det_on_primary</item>
        <item name="colorPrimaryContainer">@color/det_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/det_on_primary_container</item>
        <item name="colorSecondary">@color/det_secondary</item>
        <item name="colorOnSecondary">@color/det_on_secondary</item>
        <item name="colorSecondaryContainer">@color/det_secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/det_on_secondary_container</item>
        <item name="colorTertiary">@color/det_secondary</item>
        <item name="colorOnTertiary">@color/det_on_secondary</item>

        <item name="android:colorBackground">@color/det_background</item>
        <item name="colorSurface">@color/det_surface</item>
        <item name="colorSurfaceContainerLow">@color/det_surface_container_low</item>
        <item name="colorSurfaceContainer">@color/det_surface_container</item>
        <item name="colorSurfaceContainerHigh">@color/det_surface_container_high</item>
        <item name="colorSurfaceVariant">@color/det_surface_variant</item>
        <item name="colorOnSurface">@color/det_on_surface</item>
        <item name="colorOnSurfaceVariant">@color/det_on_surface_variant</item>
        <item name="colorOutline">@color/det_outline</item>
        <item name="colorOutlineVariant">@color/det_outline_variant</item>
        <item name="colorError">@color/det_error</item>
        <item name="colorOnError">@color/det_on_error</item>

        <item name="materialCardViewStyle">@style/Widget.DET.Card</item>
    </style>

    <style name="Theme.DailyExpenseTrackerOffline" parent="Base.Theme.DailyExpenseTrackerOffline" />

    <!-- Cards: flat, hairline outline, consistent radius -->
    <style name="Widget.DET.Card" parent="Widget.Material3.CardView.Outlined">
        <item name="cardBackgroundColor">?attr/colorSurface</item>
        <item name="cardCornerRadius">@dimen/radius_card</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">?attr/colorOutlineVariant</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="Widget.DET.Card.Hero">
        <item name="cardBackgroundColor">@color/hero_background</item>
        <item name="strokeWidth">0dp</item>
    </style>

    <!-- Typography -->
    <style name="TextAppearance.DET.Greeting" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <style name="TextAppearance.DET.Amount" parent="TextAppearance.Material3.DisplaySmall">
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.DET.AmountSmall" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <style name="TextAppearance.DET.SectionTitle" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <style name="TextAppearance.DET.Label" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>

    <style name="TextAppearance.DET.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>
</resources>

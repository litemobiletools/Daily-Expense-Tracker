<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Only for the optional Google Drive connection (HTTPS to Google). Nothing is sent unless the user connects Drive. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".DailyExpenseApp"
        android:allowBackup="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.DailyExpenseTrackerOffline">
        <activity
            android:name=".ui.main.MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".ui.add.AddTransactionActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:exported="false"
            android:label="@string/add_transaction_title"
            android:parentActivityName=".ui.main.MainActivity"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".ui.goals.SavingsGoalsActivity"
            android:exported="false"
            android:label="@string/goals_title"
            android:parentActivityName=".ui.main.MainActivity" />
        <activity
            android:name=".ui.recurring.RecurringActivity"
            android:exported="false"
            android:label="@string/recurring_title"
            android:parentActivityName=".ui.main.MainActivity" />
        <activity
            android:name=".ui.recurring.RecurringEditorActivity"
            android:exported="false"
            android:label="@string/recurring_editor_new"
            android:parentActivityName=".ui.recurring.RecurringActivity"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".ui.insights.InsightsActivity"
            android:exported="false"
            android:label="@string/insights_title"
            android:parentActivityName=".ui.main.MainActivity" />
        <activity
            android:name=".ui.backup.BackupActivity"
            android:exported="false"
            android:label="@string/drive_title"
            android:parentActivityName=".ui.main.MainActivity" />

        <!-- Phase 10: AdMob app ID. Resource values live in res/values/ads.xml (Google's official
             test IDs; replace for release as documented there). -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="@string/admob_app_id" />
    </application>

</manifest>
